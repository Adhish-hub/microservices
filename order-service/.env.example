# Copy to .env and fill in. Never commit the real .env.
# DATABASE_URL, INVENTORY_SERVICE_URL, CATALOG_SERVICE_URL and REDIS_URL are injected by docker-compose.
# Set them here only if you run the service outside Docker.
PORT=4005

# Recovery worker: how often it scans, and how old a pending order must be before it is recovered.
RECOVERY_INTERVAL_MS=30000
STALE_ORDER_MINUTES=1