# Copy to .env and fill in. Never commit the real .env.
# DATABASE_URL is injected by docker-compose (built from DB_USER / DB_PASSWORD in the root .env).
# Set it here only if you run the service outside Docker.
PORT=4001

# MUST be identical to JWT_SECRET in gateway/.env.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m