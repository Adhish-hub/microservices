.git
.gitignore
.vscode
.idea
.windsurf
.claude
.agents
skills-lock.json

# tests and docs are not needed at runtime
tests
**/*.test.js
jest.config.*
*.md

# docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml